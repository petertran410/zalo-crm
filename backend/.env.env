# Core server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000
CRM_LOGIN_URL=http://localhost:5173

# Database - change username/password if your local Postgres differs
DATABASE_URL=postgresql://postgres:khang0104@localhost:5432/zalocrm

# Required by app config in production; useful to set in dev too
JWT_SECRET=dev-local-jwt-secret-change-me-please-32chars
ENCRYPTION_KEY=dev-local-encryption-key-change-me-32chars

# Redis / BullMQ workers
REDIS_URL=redis://localhost:6379

# Local file storage
STORAGE_DRIVER=local
UPLOAD_DIR=E:\Code\ZALOCRM\zalo-crm\backend\uploads
LOCAL_PUBLIC_URL=http://localhost:3000/files

# Optional S3/R2 storage; unused while STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=zalocrm-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# AI defaults; leave tokens empty unless you use AI features
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_AUTH_TOKEN=
GEMINI_API_KEY=
GEMINI_DEFAULT_PRO_MODEL=
GEMINI_DEFAULT_FLASH_MODEL=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_AUTH_TOKEN=
OPENAI_DEFAULT_GPT4O_MODEL=
OPENAI_DEFAULT_GPT4O_MINI_MODEL=
QWEN_BASE_URL=https://dashscope.aliyuncs.com
QWEN_AUTH_TOKEN=
QWEN_DEFAULT_PLUS_MODEL=
QWEN_DEFAULT_TURBO_MODEL=
QWEN_DEFAULT_MAX_MODEL=
KIMI_BASE_URL=https://api.moonshot.cn
KIMI_AUTH_TOKEN=
KIMI_DEFAULT_MOONSHOT_V1_MODEL=

# Security / tenant options
TENANT_GUARD_MODE=off
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_MS=2592000000
REFRESH_FAMILY_MAX_MS=7776000000
REFRESH_GRACE_MS=20000
CSP_MODE=report-only
SOCKET_REQUIRE_ACCESS_TYP=false
RLS_SET_CONFIG=false

# Optional behavior flags
MEDIA_TRASH_GC_DRYRUN=1
CONTACT_RESOLVE_FRIEND_FIRST=on
AUTOMATION_STUB_MODE=false
PRIVACY_LOCK_NEW=0

# Optional Firebase push; leave empty if not using push notifications
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional Telegram bridge; leave empty to keep bridge effectively disabled
TELEGRAM_BRIDGE_BOT_TOKEN=
TELEGRAM_BRIDGE_BOT_USERNAME=hs_crm_bridge_bot
TELEGRAM_PROVISIONER_API_ID=
TELEGRAM_PROVISIONER_API_HASH=
TELEGRAM_PROVISIONER_SESSION=

# Optional antivirus scanning for uploads
MEDIA_AV_ENABLED=0
MEDIA_AV_FAIL_CLOSED=0
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Optional encryption keys used by integration tokens; set real 64-char hex values if using FB/integrations
TOKEN_ENCRYPTION_KEY=
FB_TOKEN_ENC_KEY=19F2FB4CCCC1BB7E8961B81302587AEBFD8241058620AAC1C779A4ED356BF33D

# Optional proxy env used only when code temporarily routes through a proxy
HTTP_PROXY=
HTTPS_PROXY=
HISWEETIE_MCP_URL=https://sandbox-mcp.hisweetievietnam.com
HISWEETIE_CLIENT_ID=dieptra.sg@gmail.com
HISWEETIE_CLIENT_SECRET=Dieptra@@123

# Goal 4 (2026-07-18): mo cau CRM -> POS SANDBOX (guard chan production trong code)
HISWEETIE_BILLING_DISPATCH=enabled
